def get_josa(word, josa_type):
    """
    한글 단어의 받침 유무에 따라 적절한 조사를 반환
    
    Args:
        word: 조사를 붙일 단어
        josa_type: 조사 종류 ('을/를', '은/는', '이/가', '으로/로', '와/과')
    
    Returns:
        적절한 조사
    """
    if not word:
        return ''
    
    # 마지막 글자 추출
    last_char = word[-1]
    
    # 한글이 아닌 경우 (영어, 숫자 등)
    if not ('가' <= last_char <= '힣'):
        # 숫자나 영어의 경우 발음 기준으로 판단
        if last_char.isdigit():
            # 받침이 있는 숫자: 1, 6, 7, 8, 10
            has_batchim = last_char in '16780'
        elif last_char.isalpha():
            # 영어는 발음 기준 (간단한 규칙)
            has_batchim = last_char.upper() in 'LMNR'
        else:
            has_batchim = False
    else:
        # 한글 받침 확인
        # 한글 유니코드: (초성 * 588) + (중성 * 28) + (종성 + 1) + 0xAC00
        code = ord(last_char) - 0xAC00
        jongseong = code % 28
        has_batchim = jongseong != 0
    
    # 조사 선택
    josa_dict = {
        '을/를': ('을', '를'),
        '은/는': ('은', '는'),
        '이/가': ('이', '가'),
        '으로/로': ('으로', '로'),
        '와/과': ('과', '와')
    }
    
    if josa_type in josa_dict:
        return josa_dict[josa_type][0] if has_batchim else josa_dict[josa_type][1]
    
    return ''

def add_josa(word, josa_type):
    """단어에 조사를 붙여서 반환"""
    return word + get_josa(word, josa_type)
