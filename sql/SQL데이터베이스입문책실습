SELECT nickname, math, english, programming, (math + english + programming) / 3
FROM students;

SELECT
	nickname as 이름,
    math + english + programming AS 총점,
    (math + english + programming) / 3 AS 평균
FROM students
WHERE (math + english + programming) > 270;
